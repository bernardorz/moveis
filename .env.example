# Banco de dados
# Local: Postgres do docker-compose.
# PRD (Supabase): DATABASE_URL = pooler em modo transaction (porta 6543);
#                 DIRECT_URL   = conexão direta (porta 5432), usada pelas migrations.
DATABASE_URL="postgres://dh:dh@localhost:5432/dh_moveis"
DIRECT_URL="postgres://dh:dh@localhost:5432/dh_moveis"

# Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Usuário administrador criado pelo seed
SEED_ADMIN_NAME="Ricardo Dias"
SEED_ADMIN_EMAIL="admin@dhmoveis.com.br"
SEED_ADMIN_PASSWORD="dhmoveis123"
